# Dify × OceanBase seekdb 部署配置
# 将 seekdb 同时作为元数据库和向量数据库（推荐方案）

# ===== MetaDB: seekdb (MySQL 协议) =====
DB_TYPE=mysql
DB_USERNAME=root
DB_PASSWORD=
DB_HOST=seekdb
DB_PORT=2881
DB_DATABASE=test

# ===== Vector Store: OceanBase seekdb =====
VECTOR_STORE=oceanbase
OCEANBASE_VECTOR_HOST=seekdb
OCEANBASE_VECTOR_PORT=2881
OCEANBASE_VECTOR_USER=root
OCEANBASE_VECTOR_PASSWORD=
OCEANBASE_VECTOR_DATABASE=test

# ===== Docker Compose Profiles =====
# 只启用 seekdb，不启用 weaviate/postgres 等
COMPOSE_PROFILES=seekdb

# ===== Dify 基本配置 =====
SECRET_KEY=sk-dify-oceanbase-seekdb-2026
CONSOLE_WEB_URL=http://localhost
SERVICE_API_URL=http://localhost
APP_API_URL=http://localhost
APP_WEB_URL=http://localhost

# ===== Nginx =====
NGINX_PORT=80
NGINX_SSL_PORT=443

# ===== Redis (Dify 仍需要 Redis 做缓存/队列) =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== seekdb 容器配置 =====
SEEKDB_ROOT_PASSWORD=
